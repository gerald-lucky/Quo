# ─────────────────────────────────────────────────────────────
# DATABASE (Supabase)
# Get these from: https://supabase.com → Project Settings → Database
# ─────────────────────────────────────────────────────────────

# Pooled connection (used by Prisma in serverless/Vercel)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (used for migrations)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────
# FACEBOOK / META
# Get these from: https://developers.facebook.com → Your App
# ─────────────────────────────────────────────────────────────

# Long-lived Page Access Token
# Meta Business Suite → Settings → Page Access Tokens
FACEBOOK_PAGE_ACCESS_TOKEN="EAAxxxxxxxxxxxxxx"

# App Secret — found in App Settings → Basic
FACEBOOK_APP_SECRET="your_app_secret"

# A random string YOU choose. Enter the same value in Meta Developer
# Console → Webhooks → Verify Token field.
FACEBOOK_WEBHOOK_VERIFY_TOKEN="choose_a_random_secret_string"

# ─────────────────────────────────────────────────────────────
# ANTHROPIC (Claude AI — for generating qualifying messages)
# Get from: https://console.anthropic.com → API Keys
# ─────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxx"

# ─────────────────────────────────────────────────────────────
# OPENPHONE (SMS sending — previously called "Quo API")
# Get from: OpenPhone → Settings → API
# ─────────────────────────────────────────────────────────────

# Always: https://api.openphone.com/v1
QUO_API_URL="https://api.openphone.com/v1"

# Your OpenPhone API key (Settings → API → Generate API key)
QUO_API_KEY="your_openphone_api_key"

# Your OpenPhone phone number in E.164 format (e.g. +12345678901)
OPENPHONE_FROM="+12345678901"
