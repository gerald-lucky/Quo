generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Ad {
  id                  String   @id @default(cuid())
  name                String
  facebookFormId      String   @unique
  facebookAdId        String?
  facebookPageId      String?
  campaignName        String?
  businessContext     String?
  qualifyingParams    Json?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  leads               Lead[]

  @@map("ads")
}

model Lead {
  id                  String    @id @default(cuid())
  facebookLeadId      String    @unique
  adId                String
  ad                  Ad        @relation(fields: [adId], references: [id])
  name                String?
  email               String?
  phone               String?
  messageSent         Boolean   @default(false)
  messageSentAt       DateTime?
  messageError        String?
  sentMessage         String?
  qualificationStatus String?   @default("pending")
  rawData             Json?
  createdAt           DateTime  @default(now())
  messages            Message[]

  @@map("leads")
}

model Message {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  role      String   // "assistant" or "user"
  content   String
  createdAt DateTime @default(now())

  @@map("messages")
}
